{
  "name": "@semihbou/zod-i18n-map",
  "version": "0.0.4",
  "description": "A library for localizing zod error messages.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "locales"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/VC-Semih/zod-i18n"
  },
  "author": "VC-Semih <semihciftci.pro@gmail.com>",
  "license": "MIT",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist",
    "release": "semantic-release",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "i18next": ">=21.3.0",
    "i18next-icu": ">=2.0.0",
    "zod": ">=4.6.4"
  },
  "peerDependenciesMeta": {
    "i18next-icu": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tsconfig/node16": "^1.0.3",
    "@types/node": "^18.15.3",
    "@vitest/coverage-c8": "^0.33.0",
    "@vitest/coverage-v8": "^4.1.11",
    "c8": "^7.12.0",
    "i18next": "^22.4.9",
    "i18next-icu": "^2.4.4",
    "intl-messageformat": "^11.2.9",
    "rimraf": "^5.0.0",
    "tsup": "8.5.0",
    "typescript": "^5.7.3",
    "vite": "8.0.16",
    "vitest": "^5.0.0",
    "zod": "^4.6.4"
  }
}
