{
  "name": "zod-i18n",
  "version": "0.0.0",
  "description": "A library for localizing zod error messages.",
  "repository": "git@github.com:VC-Semih/zod-i18n.git",
  "author": "VC-Semih <semihciftci.pro@gmail.com>",
  "license": "MIT",
  "private": true,
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "run-p dev:*",
    "dev:core": "pnpm --filter=@semihbou/zod-i18n-map dev",
    "dev:with-next-i18next": "pnpm --filter=with-next-i18next dev",
    "build": "pnpm --filter=@semihbou/zod-i18n-map build",
    "coverage": "pnpm --filter=@semihbou/zod-i18n-map test:coverage",
    "test": "pnpm --filter=@semihbou/zod-i18n-map test",
    "release": "pnpm --filter=@semihbou/zod-i18n-map release",
    "prepare": "husky install"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "devDependencies": {
    "@commitlint/cli": "^17.4.2",
    "@commitlint/config-conventional": "^17.4.2",
    "@semantic-release/exec": "^7.1.0",
    "husky": "^8.0.3",
    "lint-staged": "^13.1.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.8.3",
    "semantic-release": "^25.0.9",
    "semantic-release-monorepo": "^8.0.2"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json}": [
      "prettier --write"
    ]
  },
  "engines": {
    "npm": "please_use_pnpm_instead",
    "yarn": "please_use_pnpm_instead",
    "pnpm": ">=11.0.0"
  },
  "release": {
    "extends": "semantic-release-monorepo",
    "branches": [
      "main",
      {
        "name": "beta",
        "prerelease": true
      }
    ]
  }
}
