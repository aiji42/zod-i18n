{
  "name": "zod-i18n-map",
  "version": "2.27.0",
  "description": "Translate Zod error messages with i18next. Bring your own translation files.",
  "keywords": [
    "zod",
    "i18next",
    "i18n",
    "validation",
    "error-messages",
    "localization"
  ],
  "homepage": "https://github.com/aiji42/zod-i18n#readme",
  "bugs": "https://github.com/aiji42/zod-i18n/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiji42/zod-i18n.git"
  },
  "license": "MIT",
  "author": "aiji42 <aiji42@gmail.com> (https://twitter.com/aiji42_dev)",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "zod-i18n-map": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "locales:check": "node scripts/check-locales.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm locales:check && pnpm test && pnpm build",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "i18next": ">=23.0.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "i18next": "^26.4.6",
    "publint": "^0.3.25",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "packageManager": "pnpm@10.28.0"
}
